config_version=5

[application]
config/name="MusounD"
config/use_custom_user_dir=true
config/custom_user_dir_name="MusounD"
config/version="0.13.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1067
window/size/viewport_height=600
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.063,0.098,0.106,1)
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true

[audio]
driver/output_latency=15

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[gui]
theme/default_font_multichannel_signed_distance_field=true

[debug]
gdscript/warnings/inference_on_variant=0
